  "targets": [
    {
      "name": "Pulse",
      "id": "CF79B1BAD3D70F54153FE0B3",
      "product": "Products/Pulse.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "RDTR6557FX",
      "dependencies": [
        "PulseWidgetExtension",
        "PulseShareExtension",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Upload dSYMs to Crashlytics",
          "log-environment-variables": true,
          "input-paths": [
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${PRODUCT_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Info.plist",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist",
            "$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ \"${CONFIGURATION}\" != \"Release\" ]; then",
            "  exit 0",
            "fi",
            "",
            "if [ \"${PLATFORM_NAME}\" != \"iphoneos\" ]; then",
            "  echo \"Skipping Crashlytics dSYM upload for ${PLATFORM_NAME} ${CONFIGURATION} build\"",
            "  exit 0",
            "fi",
            "",
            "# An unsigned CI archive exercises device slices without contacting Firebase.",
            "if [ \"${PULSE_ARCHIVE_SMOKE:-NO}\" = \"YES\" ] && [ \"${CODE_SIGNING_ALLOWED}\" = \"NO\" ]; then",
            "  exit 0",
            "fi",
            "",
            "GOOGLE_SERVICE_INFO=\"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/GoogleService-Info.plist\"",
            "if [ ! -f \"${GOOGLE_SERVICE_INFO}\" ]; then",
            "  echo \"error: Missing GoogleService-Info.plist in app bundle. Add the production Firebase config before archiving Release builds.\"",
            "  exit 1",
            "fi",
            "",
            "\"${BUILD_DIR%/Build/*}/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/run\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "package": "EntropyCore",
          "product-name": "EntropyCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "GoogleSignIn-iOS",
          "product-name": "GoogleSignIn",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAnalytics",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseAuth",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseCrashlytics",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseRemoteConfig",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "lottie-ios",
          "product-name": "Lottie",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-llama-cpp",
          "product-name": "SwiftLlama",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION": "YES",
        "CODE_SIGN_ENTITLEMENTS": "Pulse/Pulse.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "RDTR6557FX",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_TESTABILITY[config=Debug]": "YES",
        "INFOPLIST_FILE": "Pulse/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0.0",
        "OTHER_DOCC_FLAGS": "--warnings-as-errors",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.bruno.Pulse-News",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_OBJC_INTEROP_MODE": "objcxx",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
